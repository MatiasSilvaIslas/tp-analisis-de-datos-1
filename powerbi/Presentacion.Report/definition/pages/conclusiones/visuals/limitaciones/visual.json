                      "color": "#55d6d2",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Datos agregados: describen, no explican causas.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#d5deec"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Desde 2022 los hogares se calculan con el Censo 2022 (cambio de denominador).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#d5deec"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Accesos/100 hogares incluye conexiones no residenciales: no es % de hogares conectados.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#d5deec"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Localidades sin período: solo una foto, sin evolución.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#d5deec"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEJORAS FUTURAS",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#55d6d2",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Cruzar con EPH (ingresos) y Censo 2022 (ruralidad) para explicar la brecha.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#d5deec"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Sumar precios y calidad de servicio; seguir la serie desde 2025.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
